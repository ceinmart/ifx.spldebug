# v0.1.1 | 2026-09-11T19:30:37Z | Criado com auxílio de ChatGPT.
# Copiar para config/local.properties e preencher com dados reais.
# Caminhos relativos são resolvidos a partir do diretório atual de execução.
sm.host=
sm.port=4554
client.ip=
# Obrigatório: saída exata de discover-supported-types-v0.1.1.sh.
# Formato: TYPE:LANGUAGE; vários pares são separados por vírgula.
# Não usar T789 e não testar números arbitrários.
psmd.supported.types=
socket.timeout.ms=10000
run.timeout.seconds=60
# URL real JCC/DRDA, usuário e arquivo com UMA chamada de rotina de teste existente.
# Não colocar senha/propriedades de credencial na URL; usar SPLDBG_PASSWORD.
jdbc.url=
jdbc.user=
call.file=config/call.sql
