# v0.1.5-config | 2026-09-15T18:56:54Z | Atualizado com auxílio de ChatGPT.
# Copiar para config/local.properties e preencher com dados reais.
# Caminhos relativos são resolvidos a partir do diretório atual de execução.
sm.host=
sm.port=4554
client.ip=
# Confirmado no bytecode de com.ibm.debug.spd.spl.internal.core.SPLRoutineService
# do ODS 2.2.1.1: tipos 0 e 1, ambos com linguagem SPL 4.
# Não adicionar os pares dos provedores Java, PL/SQL ou SQL.
psmd.supported.types=0:4,1:4
socket.timeout.ms=10000
# Janela curta para o polling consumir o registro do runtime quando a CALL retorna.
# Não corrige uma rotina que não entrou em modo debug; apenas evita falso diagnóstico por corrida local.
runtime.registration.grace.ms=1000
# 0 desabilita trace. Use 1 somente para diagnóstico do runtime Informix.
# O engine observado referencia /tmp/ifxpsmd.log; o arquivo pode conter dados privados.
debug.trace.level=0
run.timeout.seconds=60
# URL real JCC/DRDA, usuário e arquivo com UMA chamada de rotina de teste existente.
# Para Informix, prefira jdbc:ids:. Propriedades da URL são separadas por ponto e vírgula.
# Exemplo: jdbc:ids://host:9591/database:securityMechanism=3;
# O formato jdbc:db2: permanece aceito para compatibilidade com clientes antigos.
# Exemplo legado: jdbc:db2://host:9591/database:informixType=1;securityMechanism=3;
# Não colocar senha/propriedades de credencial na URL; usar SPLDBG_PASSWORD.
jdbc.url=
jdbc.user=
call.file=config/call.sql
